#!/bin/bash
# AirSense — commands for Raspberry Pi · Luckfox Pico · Debian/Ubuntu (Nikolaos K. Paridis (aka nikkpap) · ALU DEV TEAM)
APP=/opt/airsense/AirSense.py
DATA=/var/lib/airsense
U=$(cat /var/lib/airsense/user 2>/dev/null); [ -n "$U" ] || U=$(getent passwd 1000 | cut -d: -f1); U=${U:-root}
UH=$(getent passwd "$U" | cut -d: -f6); [ -d "$UH" ] || UH=$HOME
BOARD=$(cat /var/lib/airsense/board 2>/dev/null); MODEL=$(cat /var/lib/airsense/model 2>/dev/null)
app() { sudo python3 "$APP" --data "$DATA" "$@"; }
# settings change → the running server keeps its settings in memory, so: stop → change → start
cfgapp() {
  local was=0 rc
  systemctl is-active --quiet airsense-boot && { was=1; sudo systemctl stop airsense-boot; }
  app "$@"; rc=$?
  [ $was = 1 ] && { sudo systemctl start airsense-boot; echo "↻ server restarted with the new settings"; }
  return $rc
}
ip_() { hostname -I | awk '{print $1}'; }
case "${1:-status}" in
  status|doctor|diag)
    # ── full diagnosis in one screen ──
    G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; B='\033[1;36m'; D='\033[2m'; N='\033[0m'
    okk()  { printf "  ${G}✔${N} %-14s %s\n" "$1" "$2"; }
    bad()  { printf "  ${R}✖${N} %-14s %s\n" "$1" "$2"; PROBLEMS=$((PROBLEMS+1)); }
    wrn()  { printf "  ${Y}⚠${N} %-14s %s\n" "$1" "$2"; }
    sec()  { printf "\n${B}── %s ──${N}\n" "$1"; }
    PROBLEMS=0
    VER=$(grep -m1 -oP '^APP_VERSION = "\K[^"]+' $APP 2>/dev/null)
    printf "${B}🌬 AirSense v%s${N}  ·  %s  ·  up %s\n" "${VER:-?}" "$(hostname)" "$(uptime -p 2>/dev/null | sed 's/^up //')"
    printf "${D}   %s · %s${N}\n" "${MODEL:-?}" "$(. /etc/os-release 2>/dev/null; echo "$PRETTY_NAME")"

    sec "Server"
    if systemctl is-active --quiet airsense-boot; then okk "service" "airsense-boot running (since $(systemctl show -p ActiveEnterTimestamp --value airsense-boot | cut -d' ' -f2-3))"
    else bad "service" "airsense-boot is $(systemctl is-active airsense-boot 2>/dev/null) → airsense restart · airsense logs"; fi
    if timeout 3 bash -c 'exec 3<>/dev/tcp/127.0.0.1/8765' 2>/dev/null; then okk "web :8765" "answering"
    else bad "web :8765" "not answering → airsense logs"; fi
    systemctl is-enabled --quiet airsense-boot 2>/dev/null && okk "autostart" "enabled on boot" || bad "autostart" "NOT enabled → sudo systemctl enable airsense-boot"
    RESTARTS=$(systemctl show -p NRestarts --value airsense-boot 2>/dev/null)
    [ "${RESTARTS:-0}" -gt 3 ] && wrn "restarts" "$RESTARTS since boot (crashing?) → airsense logs"

    sec "Sensors"
    app --status 2>/dev/null | tail -n +2 | sed 's/^/  /' || wrn "sensors" "could not read status"

    sec "Network"
    IP=$(ip_); GW=$(ip route | awk '/^default/{print $3; exit}')
    [ -n "$IP" ] && okk "local IP" "$IP  →  http://$IP:8765  ·  http://$(hostname).local:8765" || bad "local IP" "no IP (Ethernet cable?)"
    IFC=$(ip -o link | awk -F': ' '/link\/ether/{print $2; exit}' | cut -d@ -f1)
    MACNOW=$(cat /sys/class/net/$IFC/address 2>/dev/null)
    if [ -f /etc/systemd/network/10-airsense-mac.link ]; then
      MACFIX=$(grep -m1 '^MACAddress=' /etc/systemd/network/10-airsense-mac.link | cut -d= -f2)
      [ "$MACNOW" = "$MACFIX" ] && okk "MAC" "$MACNOW (fixed — same IP every boot)" || wrn "MAC" "$MACNOW (fixed $MACFIX after the next reboot)"
    elif [ -n "$MACNOW" ] && [ $(( 0x${MACNOW:0:2} & 2 )) -eq 0 ]; then okk "MAC" "$MACNOW (hardware — same IP every boot)"
    else wrn "MAC" "$MACNOW (random each boot → IP may change)"; fi
    if command -v nmcli >/dev/null; then
      W=$(nmcli -t -f ACTIVE,SSID,SIGNAL dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2" ("$3"%)"; exit}')
      [ -n "$W" ] && okk "WiFi" "$W · saved: $(nmcli -t -f TYPE connection show 2>/dev/null | grep -c wireless) · airsense wifi"
    fi
    [ -n "$GW" ] && { ping -c1 -W2 "$GW" >/dev/null 2>&1 && okk "router" "$GW reachable" || bad "router" "$GW not reachable"; } || bad "router" "no default route"
    if timeout 5 bash -c 'exec 3<>/dev/tcp/1.1.1.1/443' 2>/dev/null; then
      getent hosts github.com >/dev/null 2>&1 && okk "internet" "OK (DNS OK)" || bad "internet" "online but DNS fails"
    else bad "internet" "no internet"; fi
    NTPS=$(cat $DATA/ntp.txt 2>/dev/null); TZN=$(timedatectl show -p Timezone --value 2>/dev/null)
    if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = yes ]; then okk "clock" "$(date '+%F %T') $TZN UTC$(date +%:z) (synced${NTPS:+ · $NTPS})"
    else wrn "clock" "$(date '+%F %T') $TZN UTC$(date +%:z) (NOT synced yet${NTPS:+ · $NTPS}) → airsense clock"; fi

    sec "Tailscale"
    if ! command -v tailscale >/dev/null; then
      [ -f "$UH/tailscale.sh" ] && wrn "tailscale" "ON but not installed yet → airsense tailscale" || okk "tailscale" "OFF (local only) → airsense tailscale on"
    else
      TSST=$(tailscale status --json 2>/dev/null | grep -m1 -oE '"BackendState": *"[A-Za-z]+"' | grep -oE '[A-Za-z]+"$' | tr -d '"')
      systemctl is-active --quiet tailscaled && okk "tailscaled" "running$(grep -q userspace-networking /etc/default/tailscaled 2>/dev/null && echo ' (userspace mode)')" || bad "tailscaled" "not running → airsense tailscale"
      case "$TSST" in
        Running)    TIP=$(tailscale ip -4 2>/dev/null | head -1); okk "state" "connected → http://$TIP:8765" ;;
        NeedsLogin) bad "state" "needs login → airsense tailscale" ;;
        Stopped)    bad "state" "stopped → airsense tailscale" ;;
        *)          wrn "state" "${TSST:-unknown}" ;;
      esac
      [ -f "$UH/tailscale.sh" ] && okk "on boot" "ON (~/tailscale.sh exists)" || wrn "on boot" "OFF (no ~/tailscale.sh) — Tailscale stops at next boot"
      systemctl is-active --quiet airsense-tailscale 2>/dev/null && wrn "setup" "Tailscale setup running now (/var/lib/airsense/tailscale.log)"
    fi

    sec "Updates"
    [ -f $DATA/autoupdate.off ] && wrn "auto-update" "OFF → airsense autoupdate on" || {
      systemctl is-enabled --quiet airsense-update.timer 2>/dev/null && okk "auto-update" "ON · next: $(systemctl show -p NextElapseUSecRealtime --value airsense-update.timer 2>/dev/null | cut -d' ' -f2-3)" \
        || bad "auto-update" "timer not enabled → sudo systemctl enable --now airsense-update.timer"; }
    LU=$(sudo tail -n 1 $DATA/update.log 2>/dev/null); [ -n "$LU" ] && printf "    ${D}last check: %s${N}\n" "$LU"

    sec "System"
    read -r MT MU <<<"$(free -m | awk '/Mem:/{print $2, $3}')"; read -r ST SU <<<"$(free -m | awk '/Swap:/{print $2, $3}')"
    [ "${ST:-0}" -gt 0 ] && okk "memory" "RAM ${MU}/${MT}MB · swap ${SU}/${ST}MB" || wrn "memory" "RAM ${MU}/${MT}MB · NO swap"
    DU=$(df -h / | awk 'NR==2{print $5" used, "$4" free"}'); DP=$(df / | awk 'NR==2{gsub("%","",$5); print $5}')
    [ "${DP:-0}" -lt 90 ] && okk "SD card" "$DU" || bad "SD card" "$DU (almost full!)"
    RF=$(df -m /run | awk 'NR==2{print $4}'); [ "${RF:-0}" -ge 16 ] && okk "/run" "${RF}MB free" || bad "/run" "${RF}MB free (<16MB) → sudo mount -o remount,size=32M /run"
    T=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null); [ -n "$T" ] && { [ $((T/1000)) -lt 75 ] && okk "CPU temp" "$((T/1000))°C" || wrn "CPU temp" "$((T/1000))°C (hot)"; }
    if [ -f "$UH/.airsense-default-password" ]; then wrn "password" "factory default ($(tr '\n' ' ' < "$UH/.airsense-default-password" | sed "s/user/$U/")) → airsense password"
    else okk "password" "changed (not the factory default)"; fi
    DBS=$(du -h $DATA/*.db 2>/dev/null | awk '{s=s $1" "} END{print s}'); [ -n "$DBS" ] && okk "database" "$DBS($DATA)"

    sec "Last messages"
    sudo tail -n 5 $DATA/boot.log 2>/dev/null | sed 's/^/    /'
    echo
    [ $PROBLEMS = 0 ] && printf "${G}✔ All good${N}\n" || printf "${R}✖ %d problem(s) above${N} — details: ${B}airsense logs${N}\n" $PROBLEMS ;;
  qr)       command -v qrencode >/dev/null || sudo apt-get install -y -qq qrencode
            echo "🏠 http://$(ip_):8765"; qrencode -t ANSIUTF8 "http://$(ip_):8765"
            if tailscale ip -4 >/dev/null 2>&1; then T="http://$(tailscale ip -4 | head -1):8765"; echo "🌍 $T"; qrencode -t ANSIUTF8 "$T"; fi ;;
  logs)     sudo journalctl -u airsense-boot -n 60 --no-pager; echo; sudo tail -n 30 $DATA/boot.log
            echo; echo "── Tailscale ──"; sudo tail -n 15 $DATA/tailscale.log 2>/dev/null ;;
  live)     sudo journalctl -u airsense-boot -f ;;
  restart)  sudo systemctl restart airsense-boot && echo "✔ Server restarted" ;;
  stop)     sudo systemctl stop airsense-boot && echo "■ Stopped (starts again on reboot)" ;;
  mac)      cat /var/lib/airsense/mac.txt 2>/dev/null || ip -o link | awk '/ether/{print $2, $(NF-2)}' ;;
  update)   echo "🔄 Checking GitHub for a new version…"; sudo /usr/local/sbin/airsense-update --force ;;
  autoupdate)
    case "${2:-}" in
      on)  sudo rm -f $DATA/autoupdate.off; sudo systemctl enable --now airsense-update.timer >/dev/null 2>&1
           echo "✔ Auto-update ON (every 6 hours)" ;;
      off) sudo touch $DATA/autoupdate.off; echo "✔ Auto-update OFF (manual update: airsense update)" ;;
      *)   [ -f $DATA/autoupdate.off ] && echo "Auto-update: OFF" || echo "Auto-update: ON"
           systemctl list-timers airsense-update.timer --no-pager 2>/dev/null | head -2; sudo tail -n 5 $DATA/update.log 2>/dev/null ;;
    esac ;;
  wifi)     if [ -x /usr/local/bin/airsense-wifi ]; then shift; sudo /usr/local/bin/airsense-wifi "$@"
            else echo "WiFi tool: Raspberry Pi (NetworkManager) only — this board uses Ethernet"; fi ;;
  password|passwd)
            echo "🔑 Change the password of «$(id -un)» (current first, then the new one twice):"
            passwd && sudo /usr/local/sbin/airsense-pwcheck -v
            if [ -f "$UH/.airsense-default-password" ] && grep -q '^root$' "$UH/.airsense-default-password"; then
              read -r -p "The root password is also the factory default — change it? (Y/n): " a
              case "$a" in n|N) ;; *) sudo passwd root && sudo /usr/local/sbin/airsense-pwcheck -v ;; esac
            fi ;;
  clock|time)
            if [ -n "${2:-}" ]; then
              [ -f "/usr/share/zoneinfo/$2" ] || { echo "✖ unknown time zone: $2 (list: timedatectl list-timezones)"; exit 1; }
              sudo timedatectl set-timezone "$2" && echo "✔ Time zone $2 (UTC$(TZ=$2 date +%:z))"
            fi
            sudo systemctl restart systemd-timesyncd 2>/dev/null
            timedatectl status 2>/dev/null | sed 's/^ *//' | grep -E 'Local time|Time zone|synchronized|NTP service'
            echo "NTP servers: $(grep -h '^NTP=' /etc/systemd/timesyncd.conf.d/*.conf 2>/dev/null | cut -d= -f2)"
            timedatectl timesync-status 2>/dev/null | grep -E 'Server|Poll|Offset' | sed 's/^ */  /' ;;
  set-admin) cfgapp --set-admin ;;
  set-pin)  cfgapp --set-pin "${2:-}" ;;
  add)      [ -n "${2:-}" ] || { echo "Usage: airsense add 192.168.1.241   (or: airsense scan)"; exit 1; }
            cfgapp --add "$2" ;;
  scan)     echo "🔍 Looking for BleBox sensors on the network (only sensors are added)…"
            cfgapp --scan ${2:+"$2"} ;;
  city)     shift; cfgapp --locate "$*" ;;
  tailscale)
    case "${2:-}" in
      on)  cp -f /usr/local/share/airsense/tailscale.sh "$UH/tailscale.sh" 2>/dev/null || { echo "✖ tailscale.sh template is missing"; exit 1; }
           sudo chown "$(stat -c %U "$UH")": "$UH/tailscale.sh"; echo "✔ Tailscale ON ($UH/tailscale.sh exists)"; sudo bash "$UH/tailscale.sh" ;;
      off) [ -f "$UH/tailscale.sh" ] && mv -f "$UH/tailscale.sh" "$UH/tailscale.sh.off"
           sudo tailscale down 2>/dev/null; sudo systemctl disable --now tailscaled 2>/dev/null
           echo "✔ Tailscale OFF — local only (file renamed to tailscale.sh.off)" ;;
      *)   if [ -f "$UH/tailscale.sh" ]; then
             K=$(grep -m1 -oP '^AUTHKEY="\K[^"]*' "$UH/tailscale.sh")
             T=/usr/local/share/airsense/tailscale.sh; [ -f "$T" ] || T="$UH/tailscale.sh"
             sudo AIRSENSE_TS_AUTHKEY="$K" bash "$T"
           else echo "Tailscale OFF → airsense tailscale on"; fi ;;
    esac ;;
  uninstall) sudo systemctl disable --now airsense-boot airsense-update.timer airsense-bootwifi airsense-run-size 2>/dev/null
             sudo rm -f /etc/systemd/system/airsense-boot.service /etc/systemd/system/airsense-update.* /etc/systemd/system/airsense-bootwifi.service \
               /etc/systemd/system/airsense-run-size.service /usr/local/sbin/airsense-boot /usr/local/sbin/airsense-update /usr/local/sbin/airsense-pwcheck \
               /etc/profile.d/airsense-password.sh /usr/local/bin/airsense-wifi; sudo systemctl daemon-reload
             sudo rm -rf /opt/airsense; echo "✔ Removed (data is kept in $DATA)"; sudo rm -f /usr/local/bin/airsense ;;
  *) cat <<EOF
airsense  (= airsense status) full diagnosis: server, sensors, network, Tailscale, updates, system
airsense qr                  QR codes for the phone
airsense mac                 network address (MAC) — for a DHCP reservation in the router
airsense wifi                Raspberry Pi WiFi: scan, add, saved networks (menu)
airsense password            change the login password (and root's, if factory default)
airsense clock [Zone/City]   clock, time zone, NTP sync (e.g. airsense clock Europe/Athens)
airsense logs | live         messages / live log
airsense restart             restart the server
airsense update              check GitHub + update now
airsense autoupdate [on|off] automatic updates (every 6 hours)
airsense set-admin           admin password
airsense set-pin 1234        PIN for the web page (empty = none)
airsense scan [10.0.0.0/24]  find + add BleBox sensors on the network (only sensors)
airsense add 192.168.1.241   add a sensor by IP
airsense city Ptolemaida     location for the weather
airsense tailscale [on|off]  Tailscale (login / ON / OFF)
airsense uninstall
EOF
  ;;
esac
